# Freebox Configuration
FREEBOX_URL=https://mafreebox.freebox.fr
FREEBOX_LOCAL_IP=192.168.1.254
FREEBOX_APP_ID=fr.freeboxos.dashboard
FREEBOX_APP_NAME=Freebox Dashboard
FREEBOX_APP_VERSION=1.0.1
FREEBOX_DEVICE_NAME=Dashboard Web App

# Server
SERVER_PORT=3001

# Logo.dev API (public key for device icons)
VITE_LOGO_DEV_TOKEN=pk_LOGO_DEV_PUBLIC_KEY

# Dashboard security (fork)
# Password required to open the dashboard. If empty, a random one is generated
# on first start, printed in the logs and stored next to the Freebox token.
DASHBOARD_PASSWORD=
# Docker: interface the port is published on (127.0.0.1 = this machine only)
DASHBOARD_BIND=0.0.0.0
# Non-Docker: interface the Node server listens on
# HOST=127.0.0.1
# Extra allowed Freebox base URLs (comma-separated), e.g. https://192.168.0.254
# FREEBOX_ALLOWED_URLS=
